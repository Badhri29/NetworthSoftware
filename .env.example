# Server Configuration
PORT=8080
NODE_ENV=production

# Database Configuration
# For MySQL Cloud (AWS RDS, Azure Database, DigitalOcean, etc.)
# Format: mysql://username:password@host:port/database_name
# Example: mysql://admin:password123@mydb.example.com:3306/networth_db
DATABASE_URL="mysql://username:password@hostname:3306/networth_db"

# JWT Secret - CHANGE THIS TO A RANDOM STRING IN PRODUCTION
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-jwt-key-change-this-in-production
