generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  password      String
  name          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  age           Int?
  gender        String?
  phone         String?
  photo         String?
  assets        Asset[]
  categories    Category[]
  liabilities   Liability[]
  subCategories SubCategory[]
  transactions  Transaction[]

  @@map("users")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  type        String
  category    String?
  subcategory String?
  description String?
  amount      Float
  paymentMode String
  card        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "transactions_userId_fkey")
  @@map("transactions")
}

model Category {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  type          String
  name          String
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id])
  subCategories SubCategory[]

  @@unique([userId, type, name], name: "userId_type_name")
  @@map("categories")
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  categoryId Int      @map("category_id")
  name       String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, categoryId, name], name: "userId_categoryId_name")
  @@index([categoryId], map: "sub_categories_category_id_fkey")
  @@map("sub_categories")
}

model Asset {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  type      String
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "assets_userId_fkey")
  @@map("assets")
}

model Liability {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  type      String
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "liabilities_userId_fkey")
  @@map("liabilities")
}

model default_categories {
  id                    Int                     @id @default(autoincrement())
  type                  String
  name                  String
  createdAt             DateTime                @default(now())
  default_subcategories default_subcategories[]
}

model default_subcategories {
  id                 Int                @id @default(autoincrement())
  category_id        Int
  name               String
  createdAt          DateTime           @default(now())
  default_categories default_categories @relation(fields: [category_id], references: [id], map: "Default_SubCategories_category_id_fkey")

  @@index([category_id], map: "Default_SubCategories_category_id_fkey")
}
